FROM node:22-alpine AS build

WORKDIR /build
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci
COPY apps/frontend/index.html apps/frontend/vite.config.js ./
COPY apps/frontend/postcss.config.js apps/frontend/tailwind.config.js ./
COPY apps/frontend/src ./src
RUN npm run build

FROM nginx:1.27-alpine
RUN rm /etc/nginx/conf.d/default.conf \
    && chown -R nginx:nginx /var/cache/nginx /var/run /etc/nginx/conf.d
COPY deployment/private-staging/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /build/dist /usr/share/nginx/html

USER nginx
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=5 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/frontend-health"]

CMD ["nginx", "-g", "daemon off;"]
