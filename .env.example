# ============================================================
# ARIA — Environment Variables
# Copy this file to apps/backend/.env and fill in your values.
# NEVER commit .env to git.
# ============================================================


# ── LLM Provider Selection ───────────────────────────────────
# Pick ONE provider. Set the matching API key below.
# Valid: anthropic | ollama | groq | google | openrouter | kimi | qwen | openai

LLM_PROVIDER=anthropic           # default — Claude

# Optional: override model per tier
# LLM_MODEL=                     # for get_llm() direct calls

# Fast tier (routing, classification) — cheap/local
# FAST_LLM_PROVIDER=groq
# FAST_LLM_MODEL=llama-3.1-8b-instant

# Smart tier (PR review, KPI analysis, high-stakes)
# SMART_LLM_PROVIDER=anthropic
# SMART_LLM_MODEL=claude-sonnet-4-6


# ── API Keys (set only for your chosen provider) ─────────────

# Anthropic — Claude Haiku / Sonnet / Opus
# Models: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-7
ANTHROPIC_API_KEY=

# Groq — FREE tier 14,400 req/day. Fast inference.
# Models: llama-3.3-70b-versatile | llama-3.1-8b-instant | gemma2-9b-it | mixtral-8x7b-32768
# https://console.groq.com
GROQ_API_KEY=

# Google AI Studio — Gemma 3/4, Gemini Flash/Pro
# Models: gemma-3-4b-it | gemma-3-27b-it | gemini-1.5-flash | gemini-2.0-flash
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# OpenRouter — 200+ models via one API (Qwen, Llama, Mistral, Gemma...)
# Models: qwen/qwen-2.5-72b-instruct | meta-llama/llama-3.3-70b-instruct | google/gemma-3-27b-it
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Kimi / Moonshot AI — excellent for long-context (PR diffs, architecture docs)
# Models: moonshot-v1-8k | moonshot-v1-32k | moonshot-v1-128k
# https://platform.moonshot.cn
MOONSHOT_API_KEY=

# Qwen / Alibaba DashScope
# Models: qwen-max | qwen-plus | qwen-turbo | qwen2.5-72b-instruct
# https://dashscope.aliyuncs.com
DASHSCOPE_API_KEY=

# OpenAI
# Models: gpt-4o-mini | gpt-4o
OPENAI_API_KEY=

# Ollama (local — no key needed)
# Install: https://ollama.com  then: ollama pull llama3.2
# Set LLM_PROVIDER=ollama  LLM_MODEL=llama3.2
# Other models: qwen2.5-coder | gemma3 | mistral | phi3


# ── Provider package install commands ────────────────────────
# uv add langchain-anthropic     (already installed)
# uv add langchain-ollama
# uv add langchain-groq
# uv add langchain-google-genai
# uv add langchain-openai        (covers OpenRouter, Kimi, Qwen, OpenAI)


# ── LangSmith Tracing (optional, highly recommended) ─────────
# https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ARIA


# ── Microsoft Teams Bot (Week 13) ────────────────────────────
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=


# ── ARIA Runtime ─────────────────────────────────────────────
ARIA_ENV=development
