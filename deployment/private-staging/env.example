# Private staging template only. Never commit populated credentials or keys.
ARIA_DATA_DIR=/data/aria
ARIA_LEDGER_V2_PATH=/data/aria/work_ledger_v2.jsonl
ARIA_EXECUTION_MODE=offline_mock
ARIA_CONNECTOR_MODE=fixtures
CONNECTOR_MODE=fixtures
CONNECTOR_PROVIDER_ALLOWLIST=
JIRA_HOST_ALLOWLIST=
# Generate a local 32-byte URL-safe base64 key; never commit its value.
ARIA_CREDENTIAL_MASTER_KEY=
# Signing key for the identity boundary. REQUIRED: without it every
# /api/platform/* route returns 503 authentication_unavailable, so identity,
# tenancy and credential management are all unreachable. Minimum 32 bytes.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit its value.
ARIA_PRIVATE_AUTH_SECRET=
# Mount the legacy UNAUTHENTICATED routers (/api/v2, /api/v3, /api/v4, /voice).
# Default false: they carry no token check and are reachable by anything that can
# reach the port. Enable only for local development behind loopback.
ARIA_STAGING_LEGACY_API=false
ARIA_LIVE_EXECUTION=false
