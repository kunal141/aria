FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    ARIA_DATA_DIR=/data/aria \
    ARIA_LEDGER_V2_PATH=/data/aria/work_ledger_v2.jsonl \
    ARIA_EXECUTION_MODE=offline_mock \
    ARIA_CONNECTOR_MODE=fixtures \
    CONNECTOR_MODE=fixtures \
    ARIA_LIVE_EXECUTION=false

WORKDIR /app

COPY deployment/private-staging/backend-requirements.lock /tmp/backend-requirements.lock
RUN python -m pip install --no-cache-dir -r /tmp/backend-requirements.lock \
    && rm /tmp/backend-requirements.lock \
    && groupadd --gid 10001 aria \
    && useradd --uid 10001 --gid aria --no-create-home --shell /usr/sbin/nologin aria \
    && mkdir -p /data/aria \
    && chown -R aria:aria /data/aria

COPY --chown=aria:aria apps/backend/aria /app/aria

USER 10001:10001
EXPOSE 8000
VOLUME ["/data/aria"]

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD ["python", "-c", "import json,urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=3); assert r.status == 200 and json.load(r)['status'] == 'ready'"]

CMD ["python", "-m", "uvicorn", "aria.api.staging:build_staging_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
